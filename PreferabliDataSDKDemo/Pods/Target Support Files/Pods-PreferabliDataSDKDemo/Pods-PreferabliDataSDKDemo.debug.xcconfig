ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/TTGSnackbar"
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/Mixpanel-swift" "${PODS_CONFIGURATION_BUILD_DIR}/PreferabliDataSDK" "${PODS_CONFIGURATION_BUILD_DIR}/TTGSnackbar" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/Mixpanel-swift/Mixpanel.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/PreferabliDataSDK/PreferabliDataSDK.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/TTGSnackbar/TTGSnackbar.modulemap"
OTHER_LDFLAGS = $(inherited) -ObjC -l"Alamofire" -l"Mixpanel-swift" -l"PreferabliDataSDK" -l"TTGSnackbar" -framework "CoreTelephony" -framework "Foundation" -framework "UIKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "-F${PODS_CONFIGURATION_BUILD_DIR}/Mixpanel-swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/PreferabliDataSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/TTGSnackbar"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/Mixpanel-swift/Mixpanel.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/PreferabliDataSDK/PreferabliDataSDK.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/TTGSnackbar/TTGSnackbar.modulemap"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
SWIFT_INCLUDE_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/Mixpanel-swift" "${PODS_CONFIGURATION_BUILD_DIR}/PreferabliDataSDK" "${PODS_CONFIGURATION_BUILD_DIR}/TTGSnackbar"
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
